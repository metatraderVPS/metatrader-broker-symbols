   if(canonical=="XAUEUR") { string a[]={"XAUEUR","XAUEUR.p","GOLDEURO","XAUEUR-T","GOLD/EUR","XAU_EUR","XAUEURp","XAUEURpro","XAUEUR.","XAUEURm","GOLDEUR","XAUEUR.raw","XAUEUR.x","XAUEUR.iux","XAUEUR.ecn","XAUEUR..","XAUEUR=","XAUEUR!","XAUEUR.z"}; return(PickExisting(a)); }
   if(canonical=="XAUUSD") { string a[]={"XAUUSD","GOLD","XAUUSD.s","XAUUSD.","GOLD-T","GOLD_USD","GOLD.f","XAUUSDx","XAUUSDm","XAUUSD.p","GOLD.m","XAUUSD.ecn","XAUUSD!","XAUUSD.S","XAUUSDpm","GOLDsb","Gold#","XAU_USD","GOLDUSD","XAUUSD247p","XAUUSDpro","GOLD.12","XAUUSD#","XAUUSDf","XAUUSD.e","XAUUSD.raw","GOLDs+","Gold","GOLDX","XAUUSDTTBAR.s","XAUUSD.std","XAUUSD.iux","XAUUSD.ffx","XAUUSD.MRC","XAUUSD..","XAUUSD_SG","XAUUSD=","GOLD.S","XAUUSDMic","XAUUSD.1","XAUUSD.c","XAUUSDi","XAUUSD.z"}; return(PickExisting(a)); }
   if(canonical=="XPDUSD") { string a[]={"XPDUSD","PALLADIUM","Palladium","XPDUSD.m","XPDUSD.p","XPDUSD.S","XPDUSD.pxm","XPD_USD","XPDUSDp","XPDUSDpro","XPDUSDm","XPDUSD#","PALLADIUM+","XPDUSD.s","XPDUSD.iux","XPDUSD.g","XPDUSD.ffx","PALLADIUM.f","XPDUSD.ecn","XPDUSD..","XPDUSD.","XPDUSD=","XPDUSD!","XPDUSDi","XPDUSD.r","XPDUSD.z"}; return(PickExisting(a)); }
   if(canonical=="XPTUSD") { string a[]={"XPTUSD","PLATINUM","Platinum","XPTUSD.mq","XPTUSD.p","XPTUSD.S","XPTUSD.hg","XPT_USD","XPTUSDp","XPTUSDx","XPTUSDpro","XPTUSDm","XPTUSD#","PLATINUM+","XPTUSD.pro","XPTUSD-f","XPTUSD.iux","XPTUSD.ffx","PLATINUM.f","XPTUSD.ecn","XPTUSD..","XPTUSD.","XPTUSD=","XPTUSD''","XPTUSD!","XPTUSDi","XPTUSD.r","XPTUSD.z"}; return(PickExisting(a)); }
   if(canonical=="XRPUSD") { string a[]={"XRPUSD","XRPUSDT","XRPUSD.","XRPUSD-T","XRPUSD#","XRPUSDm","XRPUSD.futu","XRPUSD=","XRPUSD.c"}; return(PickExisting(a)); }
   if(canonical=="ZARJPY") { string a[]={"ZARJPY","ZARJPY.p","ZARJPY.fx","ZARJPY.pxm","ZARJPYpro","ZARJPY#","ZARJPYm","ZARJPYfw","ZARJPY."}; return(PickExisting(a)); }
   return(ScanTerminal(canonical));
}

// Clamp a desired volume to the broker's min/max and snap it to its step.
// Skipping this is the usual cause of error 131 (invalid trade volume).
double NormalizeLots(string canonical,double desired)
{
   string s=ResolveSymbol(canonical);
   if(s=="") return(0.0);
   double mn=SymbolInfoDouble(s,SYMBOL_VOLUME_MIN), st=SymbolInfoDouble(s,SYMBOL_VOLUME_STEP), mx=SymbolInfoDouble(s,SYMBOL_VOLUME_MAX);
   if(st<=0.0) st=0.01;
   double v=MathFloor(desired/st+0.0000001)*st;
   if(v<mn) v=mn;
   if(mx>0.0 && v>mx) v=mx;
   return(NormalizeDouble(v,2));
}
