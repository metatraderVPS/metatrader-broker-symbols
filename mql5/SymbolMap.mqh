//+------------------------------------------------------------------+
//|  SymbolMap.mqh  (MQL5)                                             |
//|  Resolve a canonical instrument name to THIS broker's symbol.      |
//|                                                                    |
//|  github.com/metatraderVPS/metatrader-broker-symbols                |
//|  Data CC BY 4.0 · code MIT                                         |
//|                                                                    |
//|  Why this exists: MetaTrader symbol names are case-sensitive and   |
//|  are never fuzzy-matched, so an EA that hard-codes "XAUUSD" simply |
//|  fails on a broker quoting "XAUUSD.m". Resolution order:           |
//|    1. the canonical name itself                                    |
//|    2. every spelling seen across 241 measured brokers                 |
//|    3. a suffix/prefix scan of the terminal's own symbol list       |
//|  Step 3 means this keeps working on a broker not in the dataset.   |
//+------------------------------------------------------------------+
#property strict

// Returns the first symbol in the array that exists on this terminal.
string PickExisting(string &candidates[])
{
   int n=ArraySize(candidates);
   for(int i=0;i<n;i++)
     {
      string s=candidates[i];
      if(SymbolSelect(s,true)) return(s);
     }
   return("");
}

// Last-resort scan: any Market Watch symbol starting with the canonical
// name, which catches suffix schemes we have never seen.
string ScanTerminal(string canonical)
{
   int total=SymbolsTotal(false);
   for(int i=0;i<total;i++)
     {
      string s=SymbolName(i,false);
      if(StringFind(s,canonical)==0 && SymbolSelect(s,true)) return(s);
     }
   return("");
}

// Main entry point. Returns "" if this broker does not offer the instrument.
string ResolveSymbol(string canonical)
{
   string direct[1]; direct[0]=canonical;
   string hit=PickExisting(direct);
   if(hit!="") return(hit);

   if(canonical=="ASX200") { string a[]={"AUS200","AU200","ASX200","AUS200Cash",".AUS200",".AUS200Cash","[AUS200]-T","AU200U6","AUS200c","AUS200.c","AUS200+","#AUS200","#ASX200","AU200.S","#AU200H_","ASX200.cash","AUS200_SPOT","AUS200p","AU200.E","AUS200_m","AUS200Cash#","AU200x","AUS200spot","AUS200.","AU200=","AU200.mt4",".AUS200.","AU200Cash"}; return(PickExisting(a)); }
   if(canonical=="AUDCAD") { string a[]={"AUDCAD","AUDCAD.","AUDCAD!","AUDCAD-T","AUDCAD.c","AUDCAD.p","AUDCAD.fx","AUDCAD.s","AUDCAD.ecn","AUDCAD.S","AUDCAD.a","AUDCAD...","AUDCAD.P","AUDCADp","AUDCADpro","AUDCAD.esw","AUDCADm","AUDCADf","AUDCAD.e","AUDCAD.raw","AUDCAD+","AUDCAD-","AUDCAD.x","AUDCADx","AUDCAD.iux","AUDCAD.ffx","AUDCAD.MRC","AUDCAD..","AUDCAD_SG","AUDCAD.min","AUDCAD=","AUDCADi","AUDCADv","AUDCAD.z"}; return(PickExisting(a)); }
   if(canonical=="AUDCHF") { string a[]={"AUDCHF","AUDCHF.","AUDCHF!","AUDCHF-T","AUDCHF.p","AUDCHF.fx","AUDCHF.s","AUDCHF.ecn","AUDCHF.S","AUDCHF...","AUDCHF.sb","AUDCHFp","AUDCHF.c","AUDCHFpro","AUDCHF.esw","AUDCHFm","AUDCHFv","AUDCHFf","AUDCHF.e","AUDCHF.raw","AUDCHF+","AUDCHF-","AUDCHF.x","AUDCHFx","AUDCHF.iux","AUDCHF.ffx","AUDCHF.MRC","AUDCHF..","AUDCHF_SG","AUDCHF.min","AUDCHF=","AUDCHFi","AUDCHF.z"}; return(PickExisting(a)); }
   if(canonical=="AUDJPY") { string a[]={"AUDJPY","AUDJPY!","AUDJPY-T","AUDJPY.","AUDJPY.z","AUDJPY.fx","AUDJPY.s","AUDJPY.ecn","AUDJPY.S","AUDJPY.a","AUDJPY...","AUDJPY.sb","AUDJPYp","AUDJPY.c","AUDJPYpro","AUDJPY.esw","AUDJPY#","AUDJPYm","AUDJPYf","AUDJPY.e","AUDJPY.raw","AUDJPY+","AUDJPY-","AUDJPYx","AUDJPY.iux","AUDJPY.ffx","AUDJPY.MRC","AUDJPY..","AUDJPY_SG","AUDJPY.min","AUDJPY=","AUDJPY.sg","AUDJPYMic","AUDJPY.1","AUDJPY.t","AUDJPYi","AUDJPY.p"}; return(PickExisting(a)); }
